# Copy to .env.local for local development, and add the same values to your Vercel project.
# Everything below comes from your own Supabase project (Project Settings → API / Database).

# --- Supabase (public: safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The deployed URL, used for sign-in redirects. Optional locally (defaults to the request origin).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Server only (never prefix these with NEXT_PUBLIC_) ---

# Copy both from the "Connect" button at the top of your Supabase project, replacing
# <region> with your project's region (e.g. ap-southeast-2). Use the *pooler* strings: the
# "Direct connection" host (db.<ref>.supabase.co) is IPv6-only on the free tier and is
# unreachable from WSL and many networks.

# Used by the app. `pnpm db:app-role` fills this in with the restricted flash_cards_app role
# on the Transaction pooler (port 6543). This is the value to put in Vercel.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-<region>.pooler.supabase.com:6543/postgres

# "Session pooler" (port 5432), as the database owner. Only used locally by `pnpm db:migrate`
# and `pnpm db:app-role`; never add it to Vercel.
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-<region>.pooler.supabase.com:5432/postgres

# Only used by `pnpm admin:create` to create your account. Not needed on Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The one account allowed to use the app.
ADMIN_EMAIL=you@example.com

# Optional: also require GitHub sign-ins to come from this GitHub username.
# ADMIN_GITHUB_USERNAME=your-github-username

# Protects the daily keep-alive cron (any random string of 16+ characters, e.g. `openssl rand -hex 32`).
CRON_SECRET=replace-with-a-long-random-string
